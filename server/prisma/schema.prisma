 generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  gamingId Int   @unique
  username String @unique
  password String
  email    String @unique

  pokemon UserPokemon[]
}


model Pokemon {
  id     Int    @id
  name   String @unique
  image  String
  type   String
  hp     Int
  attack Int

  owners UserPokemon[]
}

model UserPokemon {
  id       Int @id @default(autoincrement())
  userId   Int
  pokemonId Int


  user     User   @relation(fields: [userId], references: [id])
  pokemon  Pokemon @relation(fields: [pokemonId], references: [id])

  @@unique([userId, pokemonId])
}


